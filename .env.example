APP_NAME="PSB SMKN 2 Singosari"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database: sqlite (default, paling mudah) atau mysql
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# Untuk MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=psb_smkn2
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Password admin (dipakai seeder untuk membuat akun admin)
ADMIN_PASSWORD=admin1234
